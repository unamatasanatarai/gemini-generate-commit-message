#!/usr/bin/env bash

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-"$HOME/.config"}

for dep in curl jq; do
    if ! command -v "${dep}" >/dev/null 2>&1; then
        printf "Error: missing dependency: %s\n" "${dep}" >&2
        exit 1
    fi
done

if [[ -z ${GEMINI_API_KEY:-} ]]; then
    if [[ -r $XDG_CONFIG_HOME/gcg/key ]]; then
        IFS= read -r GEMINI_API_KEY <"$XDG_CONFIG_HOME/gcg/key"

        if [[ $? -ne 0 && -z $GEMINI_API_KEY ]]; then
            printf 'Error: failed to read API key\n' >&2
            exit 2
        fi
    fi
fi

if [[ -z ${GEMINI_API_KEY:-} ]]; then
    printf 'Error: GEMINI_API_KEY is not set\n' >&2
    printf 'Please set GEMINI_API_KEY or save it in %s/gcg/key\n' "$XDG_CONFIG_HOME" >&2
    exit 3
fi

curl -fsS \
    "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY" |
    jq -r '
        .models[]
        | .name |= sub("^models/"; "")
        | "<\(.name)>\n   \(.description // "No description")\n"
    '

if [[ $? -ne 0 ]]; then
    printf 'Error: failed to fetch or parse model list\n' >&2
    exit 4
fi
